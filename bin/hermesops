#!/usr/bin/env bash
# ==============================================================================
# HermesOps - 入口程序 (v5.0.0 - 分布式矩阵协同版)
# ==============================================================================

export START_DIR="$(pwd)"

RED='\033[0;91m'
GREEN='\033[0;92m'
YELLOW='\033[1;93m'
BLUE='\033[0;94m'
PURPLE='\033[0;95m'
CYAN='\033[0;96m'
WHITE='\033[1;97m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# 按严格依赖链强行载入核心解耦组件与分布式协同内核
if [ -f "$HOME/.hermesops/core/env.sh" ]; then source "$HOME/.hermesops/core/env.sh"; else exit 1; fi
if [ -f "$HOME/.hermesops/core/loader.sh" ]; then source "$HOME/.hermesops/core/loader.sh"; else exit 1; fi
if [ -f "$HOME/.hermesops/core/ui.sh" ]; then source "$HOME/.hermesops/core/ui.sh"; else exit 1; fi
if [ -f "$HOME/.hermesops/core/grid_engine.sh" ]; then source "$HOME/.hermesops/core/grid_engine.sh"; fi

declare -A DAEMON_PIDS

# ⚡ [LangGraph 思想扩展] 全局清理与断点持久化挂起
cleanup() {
    # 捕获退出状态：如果在进行协同任务，强行挂起并存档
    if [ -n "$CURRENT_GRID_TASK" ]; then
        echo -e "\n${YELLOW}💾 [LangGraph Persistence] 检测到环境中断，正在为活动任务 [${CURRENT_GRID_TASK}] 保存现场快照...${NC}"
        if command -v grid_checkpoint_save &>/dev/null; then
            grid_checkpoint_save "$CURRENT_GRID_TASK" "PAUSED" "" "" ""
        fi
    fi

    if [ ${#DAEMON_PIDS[@]} -gt 0 ]; then
        echo -e "\n${YELLOW}🧹 正在安全收回插件运行池并同步退出...${NC}"
        for service in "${!DAEMON_PIDS[@]}"; do
            local pid=${DAEMON_PIDS[$service]}
            if kill -0 "$pid" >/dev/null 2>&1; then kill -15 "$pid" >/dev/null 2>&1; fi
        done
    fi
}
trap cleanup EXIT INT TERM HUP

# ⚔️ [大厂多 Agent CLI 路由扩展] 支持通过命令行直接下达子任务控制指令
handle_cli_commands() {
    case "$1" in
        "spawn")
            # [Anthropic + SWE-agent] 派发子任务沙盒
            # 用法: ai-tools spawn [子任务名] [指派小兵] [允许修改的文件]
            if [ -z "$2" ] || [ -z "$3" ] || [ -z "$4" ]; then
                echo -e "${RED}✗ 参数缺失。用法: hermesops spawn <subtask_id> <worker_plugin> <allowed_files_comma_separated>${NC}"
                exit 1
            fi
            grid_spawn_sandbox "$2" "$3" "$4"
            exit 0
            ;;
        "verify")
            # [AgentCoder + CodeGraph] 自动回归测试与图谱边界核验
            # 用法: ai-tools verify [子任务名]
            if [ -z "$2" ]; then
                echo -e "${RED}✗ 参数缺失。用法: hermesops verify <subtask_id>${NC}"
                exit 1
            fi
            grid_verify_and_merge "$2"
            exit 0
            ;;
        "handoff")
            # [AutoGen] 异步控制权抛接路由
            # 用法: ai-tools handoff [子任务名] [当前小兵] [接管小兵] [异常原因]
            if [ -z "$2" ] || [ -z "$3" ] || [ -z "$4" ]; then
                echo -e "${RED}✗ 参数缺失。用法: hermesops handoff <subtask_id> <from_worker> <to_agent> [reason]${NC}"
                exit 1
            fi
            grid_handoff_signal "$2" "$3" "$4" "$5"
            exit 0
            ;;
        "checkpoint")
            # 打印长效记忆断点状态
            if command -v get_project_hash &>/dev/null; then
                local db_file="$HOME/.hermesops/projects/$(get_project_hash).json"
                if [ -f "$db_file" ]; then
                    echo -e "${CYAN}📊 [LangGraph Memory] 当前项目长效断点快照：${NC}"
                    cat "$db_file"
                else
                    echo -e "${YELLOW}🏠 当前工作区干净，暂无长期记忆挂起。${NC}"
                fi
            fi
            exit 0
            ;;
        "web")
            # 🌐 [前端控制台] 前台独立启动 Web 导航总线
            # 用法: hermesops web
            launch_web_console foreground
            exit 0
            ;;
    esac
}

# 🌐 [前端控制台启动器] 拉起 Vue 3 Web 导航总线
# 用法（内部）: launch_web_console foreground | background
launch_web_console() {
    local mode="$1"
    local fe_dir="$HOME/.hermesops"

    # 1) 依赖检查：Node + npm
    if ! command -v node &>/dev/null || ! command -v npm &>/dev/null; then
        echo -e "${RED}✗ 未检测到 Node.js / npm，请先安装 Node 18+ (https://nodejs.org)${NC}"
        [ "$mode" = "foreground" ] && exit 1 || return 1
    fi

    # 2) 前端工程检查
    if [ ! -f "$fe_dir/package.json" ] || [ ! -f "$fe_dir/index.html" ]; then
        echo -e "${RED}✗ 前端工程未就位：$fe_dir/package.json 或 index.html 不存在${NC}"
        [ "$mode" = "foreground" ] && exit 1 || return 1
    fi

    # 3) 首次启动自动装依赖
    if [ ! -d "$fe_dir/node_modules" ]; then
        echo -e "${YELLOW}📦 首次启动 Web 控制台，正在安装前端依赖（约 30s）…${NC}"
        (cd "$fe_dir" && npm install --no-audit --no-fund 2>&1 | tail -3) || {
            echo -e "${RED}✗ 依赖安装失败，请手动执行: cd $fe_dir && npm install${NC}"
            [ "$mode" = "foreground" ] && exit 1 || return 1
        }
    fi

    # 4) 探测空闲端口（5173 起，被占则递增）
    local port=5173
    while ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE ":$port$"; do
        port=$((port + 1))
    done
    # 后端桥接服务端口（3001 起，被占则递增）
    local bport=3001
    while ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE ":$bport$"; do
        bport=$((bport + 1))
    done

    # 5) 启动后端桥接服务（src/server/server.mjs）—— 始终后台
    local srv="$fe_dir/src/server/server.mjs"
    if [ -f "$srv" ]; then
        PORT="$bport" nohup node "$srv" > "$fe_dir/.web-bridge.log" 2>&1 &
        local bpid=$!
        DAEMON_PIDS["web-bridge"]=$bpid
        # 等 bridge 就绪（最多 3s）
        local waited=0
        while ! ss -ltn 2>/dev/null | awk '{print $4}' | grep -qE ":$bport$" && [ $waited -lt 30 ]; do
            sleep 0.1; waited=$((waited + 1))
        done
    fi

    # 6) 同步把后端端口写入 vite 代理目标（通过环境变量传给 vite.config.ts）
    export HERMESOPS_BRIDGE_PORT="$bport"

    # 7) 启动 Vite 前端
    if [ "$mode" = "foreground" ]; then
        echo -e "${CYAN}🌐 HermesOps Web 控制台启动中 → http://localhost:$port${NC}"
        echo -e "${DIM}   后端桥接 → 127.0.0.1:$bport (PID $bpid)${NC}"
        echo -e "${DIM}   Ctrl+C 退出（仅关闭控制台，不影响后台 Agent）${NC}\n"
        (cd "$fe_dir" && npx vite --port "$port" --host)
    else
        # 后台模式：nohup 拉起，PID 入守护池，退出 HermesOps 时自动回收
        nohup bash -c "cd '$fe_dir' && npx vite --port '$port' --host" \
            > "$fe_dir/.web-console.log" 2>&1 &
        local pid=$!
        DAEMON_PIDS["web-console"]=$pid
        echo -e "${CYAN}🌐 Web 控制台已后台拉起 → http://localhost:$port${NC}"
        echo -e "${DIM}   前端 PID $pid · 后端桥接 PID $bpid (:$bport)${NC}"
        echo -e "${DIM}   日志 ~/.hermesops/.web-console.log / .web-bridge.log${NC}"
        echo -e "${DIM}   退出 HermesOps 时自动回收 · 继续进入主控制台…${NC}\n"
    fi
}

handle_top_choice() {
    local choice=$1
    case $choice in
        [0-9]*)
            local idx=$((choice - 1))
            if [[ $idx -ge 0 && $idx -lt ${#PLUGINS_KEYS[@]} ]]; then
                # 🛠️ 强行通过当前 Shell 环境直调内核函数
                invoke_start "$idx"
            else
                echo -e "${RED}✗ 越界输入，未检索到对应的框架条目${NC}"
            fi
            ;;
        a|A) install_menu ;;
        r|R) register_plugins ;;
        q|Q)
            echo -e "${GREEN}安全退出，环境已归位。${NC}"
            exit 0
            ;;
        *)
            echo -e "${RED}✗ 无效命令，请检查面板提示${NC}"
            ;;
    esac
    echo ""
    read -p "按 Enter 返回主控制台..."
}

main() {
    # 🌐 检测 --web / -W 标志：后台拉起 Web 控制台并继续正常 TUI 流程
    local launch_web_bg=0
    local clean_args=()
    for arg in "$@"; do
        case "$arg" in
            --web|-W) launch_web_bg=1 ;;
            *)        clean_args+=("$arg") ;;
        esac
    done

    # 优先拦截并路由 CLI 模式命令（已剔除 --web 标志）
    if [ ${#clean_args[@]} -gt 0 ]; then
        handle_cli_commands "${clean_args[@]}"
    fi

    # 后台拉起 Web 控制台（保留原 TUI 流程）
    if [ "$launch_web_bg" -eq 1 ]; then
        launch_web_console background
    fi

    register_plugins
    
    # [启动自检恢复] 尝试静默加载本地项目的历史断点
    if command -v get_project_hash &>/dev/null; then
        local db_file="$HOME/.hermesops/projects/$(get_project_hash).json"
        if [ -f "$db_file" ] && command -v jq &>/dev/null; then
            export CURRENT_GRID_TASK=$(jq -r '.active_task_id // empty' "$db_file")
        fi
    fi

    while true; do
        show_dashboard
        read -p "$(echo -e ${BOLD}${WHITE}➜${NC} ) " choice
        handle_top_choice "$choice"
    done
}

main "$@"